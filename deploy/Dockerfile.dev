FROM golang:1.27.3-bookworm@sha256:972b4110ba0f47539a975c31e52c64765e1ff19f2d74469ae4a595c6676e80a5 AS go-toolchain
FROM node:24.21.0-bookworm AS node-toolchain
# Magick-enabled libvips 8.18.6, built once by deploy/Dockerfile.vips.
FROM ghcr.io/biliblihuorong/imgnest-vips:8.18.6-r1-dev@sha256:e80eb82e32bff708d47acad906d112496025b845c673c62b886861b73efab38e AS dev-base
COPY --from=go-toolchain /usr/local/go /usr/local/go
COPY --from=node-toolchain /usr/local/bin/node /usr/local/bin/node
COPY --from=node-toolchain /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -sf ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm && \
    ln -sf ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx && \
    npm install -g pnpm@12.9.1 && \
    npm cache clean --force
# Same ImageMagick policy as production, so tests see the restricted coders.
COPY --chmod=0644 deploy/imagemagick-policy.xml /etc/ImageMagick-6/policy.xml
ENV PATH=/usr/local/go/bin:/go/bin:/opt/imagor/bin:$PATH
ENV CGO_ENABLED=1 GOTOOLCHAIN=local \
    GOPATH=/go GOMODCACHE=/go/pkg/mod GOCACHE=/root/.cache/go-build \
    PKG_CONFIG_PATH=/opt/imagor/lib/pkgconfig \
    CGO_CFLAGS=-I/opt/imagor/include \
    CGO_LDFLAGS="-L/opt/imagor/lib -Wl,-rpath,/opt/imagor/lib" \
    LD_LIBRARY_PATH=/opt/imagor/lib \
    MALLOC_ARENA_MAX=2 \
    LD_PRELOAD=/usr/lib/x86_64-linux-gnu/libjemalloc.so.2
WORKDIR /workspace
CMD ["go", "run", "./cmd/imgnest", "--help"]

# Compile the pinned linter only for CI's optional lint target. The final dev
# target preserves the local development image and does not build this stage.
FROM go-toolchain AS lint-toolchain
ENV CGO_ENABLED=0 GOTOOLCHAIN=local GOBIN=/out
RUN go install github.com/golangci/golangci-lint/v2/cmd/golangci-lint@v2.14.0 && \
    rm -rf /go/pkg/mod /root/.cache/go-build

FROM dev-base AS lint
COPY --from=lint-toolchain /out/golangci-lint /usr/local/bin/golangci-lint

FROM dev-base AS dev
