# syntax=docker/dockerfile:1
# Shared libvips base for ImgNest, published as ghcr.io/biliblihuorong/imgnest-vips.
# The pinned imagor image disables Magick, so its valid BMP buffers cannot load;
# this rebuilds the same libvips release with Magick enabled, once, so that the
# dev, CI and production images all link the identical binary.
#
#   target dev      -> :<tag>-dev   headers, pkg-config and build tools
#   target runtime  -> :<tag>       shared libraries only
#
# The tag lives in .github/workflows/vips-base.yml. Bump its revision whenever
# this file changes, then repin the digests in Dockerfile and Dockerfile.dev;
# scripts/test-ci-config.py checks that both pin the same release.
FROM ghcr.io/cshum/imagor-base:vips8.18.6-r14-dev AS dev
ADD --checksum=sha256:3c41e1d5458081bfa4a5bc54e116c46259c75c6760a18027764555632b9dda3e https://github.com/libvips/libvips/releases/download/v8.18.6/vips-8.18.6.tar.xz /tmp/vips.tar.xz
RUN apt-get update && apt-get install -y --no-install-recommends meson ninja-build && \
    rm -rf /var/lib/apt/lists/*
RUN tar -xf /tmp/vips.tar.xz -C /tmp && \
    meson setup /tmp/vips-build /tmp/vips-8.18.6 --prefix=/opt/imagor --libdir=lib \
      -Dmagick=enabled -Dintrospection=disabled -Ddeprecated=false && \
    ninja -C /tmp/vips-build -j 2 && ninja -C /tmp/vips-build install && \
    rm -rf /tmp/vips-build /tmp/vips-8.18.6 /tmp/vips.tar.xz

FROM dev AS libs
RUN mkdir /out && cp -a /opt/imagor/lib/libvips.so* /opt/imagor/lib/vips-modules-8.18 /out/

FROM ghcr.io/cshum/imagor-base:vips8.18.6-r14 AS runtime
# Shared libraries the Magick-enabled libvips links beyond the base image.
RUN apt-get update && \
    apt-get install -y --no-install-recommends libmagickcore-6.q16-7t64 libopenexr-3-1-30 && \
    rm -rf /var/lib/apt/lists/* && \
    ln -s "/usr/lib/$(uname -m)-linux-gnu/libjemalloc.so.2" /usr/local/lib/libjemalloc.so.2
COPY --from=libs /out/libvips.so* /opt/imagor/lib/
COPY --from=libs /out/vips-modules-8.18/ /opt/imagor/lib/vips-modules-8.18/
# Fail the build rather than the first upload if any library is unresolved.
RUN if ldd /opt/imagor/lib/libvips.so.42 /opt/imagor/lib/vips-modules-8.18/*.so | grep 'not found'; then exit 1; fi
